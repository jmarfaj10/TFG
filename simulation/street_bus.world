<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <!-- Plugin for simulating physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- Plugin for handling user commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Plugin for broadcasting scene updates -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Plugin for handling sensors like the LIDAR -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Plugin for IMU -->
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <physics type="ode">
      <max_step_size>0.003</max_step_size>   <!-- default is 0.001 -->
      <real_time_update_rate>400</real_time_update_rate>
    </physics>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="back_wall">
  <static>true</static>
  <pose>25 0 0 0 0 -1.5708</pose>
  <link name="wall_link">
    
    <visual name="wall_visual">
      <geometry>
        <box>
          <size>50 0.5 5</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </link>
</model>

  <model name="left_wall">
  <static>true</static>
  <pose>0 25 0 0 0 0</pose>
  <link name="wall_link">
    
    <visual name="wall_visual">
      <geometry>
        <box>
          <size>50 0.5 5</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </link>
</model>


  <model name="right_wall">
  <static>true</static>
  <pose>0 -25 0 0 0 0</pose>
  <link name="wall_link">
    
    <visual name="wall_visual">
      <geometry>
        <box>
          <size>50 0.5 5</size>
        </box>
      </geometry>
      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </link>
</model>


    <!-- Floor model -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>50 50 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bus Stop  -->
    <include>
      <name>bus_stop</name>
      <pose>18 0 0 0 0 1.5708</pose>
      <uri>model://bus_stop</uri>
    </include>

    <include>
      <name>cardbox1</name>
      <pose>5 0 0.6 0 0 0</pose>
      <uri>model://cardboard_box</uri>
    </include>

    <include>
      <name>cardbox2</name>
      <pose>5 0 1.5 0 0 0</pose>
      <uri>model://cardboard_box</uri>
    </include> 


    <include>
      <name>cardbox3</name>
      <pose>5 -0.5 2.4 0 0 1.57</pose>
      <uri>model://cardboard_box</uri>
    </include>

    <include>
      <name>cardbox4</name>
      <pose>5 0.5 2.4 0 0 0</pose>
      <uri>model://cardboard_box</uri>
    </include>
<!-- 
    <include>
      <name>person</name>
      <pose>5 0.5 2.4 0 0 0</pose>
      <uri>model://person_walking</uri>
    </include> -->

        <!-- Road crossing the pedestrian walk -->
    <model name="road">
      <static>true</static>
      <!-- Position aligned with the pedestrian crossing -->
      <pose>11.8 0 0.05 0 0 0</pose>
      <link name="road_link">
       
        <visual name="road_visual">
          <geometry>
            <box>
              <size>5.5 50 0.02</size>
            </box>
          </geometry>
          <material>
            <!-- Black road surface -->
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>


        <!-- Pedestrian crossing: 4 white flat boxes -->
    <model name="pedestrian_crossing">
      <static>true</static>
      <pose>10 3 0.07 0 0 0</pose>
      <link name="crossing_link">

        <!-- Stripe 1 -->
        <visual name="stripe1">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.7 5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Stripe 2 -->
        <visual name="stripe2">
          <pose>1.2 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.7 5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Stripe 3 -->
        <visual name="stripe3">
          <pose>2.4 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.7 5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Stripe 4 -->
        <visual name="stripe4">
          <pose>3.6 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.7 5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

      </link>
    </model>
  </world>
</sdf>
