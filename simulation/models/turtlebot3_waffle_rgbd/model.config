<?xml version="1.0"?>

<model>
  <name>TurtleBot3(Waffle RGBD)</name>
  <version>2.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Taehun Lim(Darby)</name>
    <email>thlim@robotis.com</email>
  </author>

  <description>
    TurtleBot3 Waffle con la camara convertida a rgbd_camera para que publique
    tambien camera/depth_image. El modelo original de turtlebot3_gazebo solo
    tiene camara RGB, por lo que /camera/depth_image nunca llevaba datos.
  </description>
</model>
